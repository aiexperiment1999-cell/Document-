# Database (any Postgres works — local, Supabase, Neon, Vercel Postgres, etc.)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/docchaser"

# Anthropic (document classification via vision)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# Twilio (SMS / WhatsApp)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# Number used for plain SMS, e.g. +15551234567
TWILIO_SMS_FROM=""
# WhatsApp-enabled number, e.g. whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=""

# Used to validate that inbound webhook requests really came from Twilio
TWILIO_VALIDATE_SIGNATURE="true"

# Base URL of this app, used to build the Twilio webhook validation URL and
# links inside reminder messages.
APP_BASE_URL="http://localhost:3000"

# Secret for the escalation cron endpoint (call it from a scheduler, e.g.
# GitHub Actions, Vercel Cron, or plain cron + curl).
CRON_SECRET="change-me"
